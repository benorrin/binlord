@model List<BinLord.Models.User>
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <div>
        <h1>Users</h1>
        <p>Admins can change everything. Editors can view and modify bin schedules. Viewers can only view.</p>
    </div>
    <a asp-action="Create" class="btn app-btn-primary">+ Add a user</a>
</div>

@if (TempData["UsersMessage"] is string message)
{
    <div class="alert alert-success mb-3">@message</div>
}
@if (TempData["UsersError"] is string error)
{
    <div class="alert alert-warning mb-3">@error</div>
}

<div class="table-panel">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Username</th>
                <th>Role</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="fw-semibold">
                        @user.Username
                        @if (user.Username == User.Identity!.Name)
                        {
                            <span class="badge text-bg-secondary">You</span>
                        }
                    </td>
                    <td><span class="freq-chip">@user.Role</span></td>
                    <td class="text-muted">@user.CreatedAt.ToString("d MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
