@model BinLord.Models.BinSchedule
@{
    ViewData["Title"] = "Add a bin schedule";
}

<h1>Add a bin schedule</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. General Waste" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Colour" class="form-label"></label>
                <input asp-for="Colour" type="color" class="form-control form-control-color" />
                <span asp-validation-for="Colour" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FirstCollectionDate" class="form-label"></label>
                <input asp-for="FirstCollectionDate" class="form-control" />
                <div class="form-text">Any date this bin is (or was) collected on. BinLord works out future dates from this.</div>
                <span asp-validation-for="FirstCollectionDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FrequencyWeeks" class="form-label"></label>
                <select asp-for="FrequencyWeeks" class="form-select">
                    <option value="1">Every week</option>
                    <option value="2">Every 2 weeks (fortnightly)</option>
                    <option value="3">Every 3 weeks</option>
                    <option value="4">Every 4 weeks</option>
                </select>
                <span asp-validation-for="FrequencyWeeks" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes, e.g. put out the night before"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
