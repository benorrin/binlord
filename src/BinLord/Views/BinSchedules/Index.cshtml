@model List<BinLord.Models.BinSchedule>
@{
    ViewData["Title"] = "Bin Schedules";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Editor");
}

<div class="page-header">
    <div>
        <h1>Bin schedules</h1>
        <p>Manage the bins BinLord reminds you about.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@ViewBag.RssUrl" class="btn btn-outline-secondary" title="Subscribe in a feed reader">📡 RSS Feed</a>
        <a href="@ViewBag.IcsUrl" class="btn btn-outline-secondary" title="Subscribe in Google/Apple/Outlook calendar">📅 Calendar (ICS)</a>
        @if (canManage)
        {
            <a asp-action="Export" class="btn btn-outline-secondary">⬇ Export JSON</a>
            <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-inline m-0">
                @Html.AntiForgeryToken()
                <label class="btn btn-outline-secondary mb-0">
                    ⬆ Import JSON
                    <input type="file" name="file" accept="application/json,.json" class="d-none" onchange="this.form.submit()" />
                </label>
            </form>
            <a asp-action="Create" class="btn app-btn-primary">+ Add a bin schedule</a>
        }
    </div>
</div>

<p class="text-muted small mb-4">
    Paste the RSS or Calendar link into your feed reader or calendar app (Google, Apple, Outlook) to subscribe &mdash; it updates automatically as you edit bin schedules.
</p>

@if (TempData["ImportSuccess"] is string importSuccess)
{
    <div class="alert alert-success mb-3">@importSuccess</div>
}
@if (TempData["ImportError"] is string importError)
{
    <div class="alert alert-warning mb-3">@importError</div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="empty-icon">🗑️</span>
        <h3>No bin schedules yet</h3>
        @if (canManage)
        {
            <p class="mb-3">Add one to get started.</p>
            <a asp-action="Create" class="btn app-btn-primary">+ Add a bin schedule</a>
        }
    </div>
}
else
{
    <div class="table-panel">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th></th>
                    <th>@Html.DisplayNameFor(m => m.First().Name)</th>
                    <th>@Html.DisplayNameFor(m => m.First().FirstCollectionDate)</th>
                    <th>Repeats every</th>
                    <th>@Html.DisplayNameFor(m => m.First().Notes)</th>
                    @if (canManage)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="bin-dot" style="background-color: @item.Colour;"></span></td>
                        <td class="fw-semibold">@item.Name</td>
                        <td class="text-muted">@item.FirstCollectionDate.ToString("d MMM yyyy")</td>
                        <td><span class="freq-chip">every @item.FrequencyWeeks week@(item.FrequencyWeeks == 1 ? "" : "s")</span></td>
                        <td class="text-muted">@item.Notes</td>
                        @if (canManage)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
