@model BinLord.Models.BinSchedule
@{
    ViewData["Title"] = "Delete bin schedule";
}

<h1>Delete bin schedule</h1>

<h3 class="text-danger">Are you sure you want to delete this?</h3>
<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-8">
                <span class="bin-dot me-1" style="background-color: @Model.Colour;"></span>
                @Model.Name
            </dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FirstCollectionDate)</dt>
            <dd class="col-sm-8">@Model.FirstCollectionDate.ToString("d MMM yyyy")</dd>
            <dt class="col-sm-4">Repeats every</dt>
            <dd class="col-sm-8">@Model.FrequencyWeeks week@(Model.FrequencyWeeks == 1 ? "" : "s")</dd>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Notes)</dt>
                <dd class="col-sm-8">@Model.Notes</dd>
            }
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
